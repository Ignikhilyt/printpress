# ==============================================
# PRINTPRESS SERVER - ENVIRONMENT VARIABLES
# ==============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ---------------------------------------------
# DATABASE
# ---------------------------------------------
# For local development, use your local PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/printpress_dev"

# For production, use a hosted database (examples):
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]
# Railway: Use the DATABASE_URL they provide
DATABASE_URL="postgresql://username:password@localhost:5432/printpress"

# ---------------------------------------------
# JWT AUTHENTICATION
# ---------------------------------------------
# CRITICAL: Generate a secure random key for production!
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_GENERATED_SECRET"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------
# SERVER CONFIGURATION
# ---------------------------------------------
NODE_ENV="development"
PORT=5000
API_VERSION="v1"

# ---------------------------------------------
# CORS & FRONTEND
# ---------------------------------------------
# For local development:
FRONTEND_URL="http://localhost:5173"

# For production, use your actual domain:
# FRONTEND_URL="https://printpress.yourdomain.com"

# ---------------------------------------------
# EMAIL CONFIGURATION
# ---------------------------------------------
# Gmail example (use App-Specific Password):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
EMAIL_FROM="PrintPress <noreply@printpress.com>"
ADMIN_EMAIL="admin@printpress.com"

# SendGrid example:
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"

# ---------------------------------------------
# FILE UPLOADS
# ---------------------------------------------
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=52428800

# For production, consider using cloud storage:
# AWS S3, Cloudinary, or similar service
# Add their credentials here when implementing

# ---------------------------------------------
# OPTIONAL: ADVANCED SETTINGS
# ---------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
