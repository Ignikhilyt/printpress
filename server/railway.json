{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacksPlan": {
            "phases": {
                "install": {
                    "cmds": [
                        "npm ci --only=production"
                    ]
                },
                "build": {
                    "cmds": [
                        "npx prisma generate"
                    ]
                }
            }
        }
    },
    "deploy": {
        "startCommand": "node server.js",
        "healthcheckPath": "/api/v1/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}